# Scripts that run on SystemRescue (Linux) must have LF endings
auditor/autorun eol=lf
auditor/*.py eol=lf
# Git hooks run under sh on every platform
.githooks/* eol=lf
# Scripts that run on Windows are safest with CRLF
restorer/Dell/Scripts/*.cmd eol=crlf
restorer/*.ps1 eol=crlf
restorer/Dell/Scripts/*.ps1 eol=crlf
# Hand- and bot-edited business state: keep LF so a one-row edit never rewrites the whole file
auditor/inventory.csv eol=lf
